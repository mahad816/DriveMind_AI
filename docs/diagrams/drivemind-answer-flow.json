  "cards": [
    { "dot": "cyan", "title": "Routing comes first", "items": ["Conversation recall, chitchat and file inventory bypass chunk retrieval and return without citations.", "Named files use direct PostgreSQL chunk lookup; general questions use the configured grounded path."] },
    { "dot": "emerald", "title": "Grounded retrieval", "items": ["Linear RAG is the default; hybrid is enabled by default and vector-only is available when disabled.", "LangGraph is optional for grounded questions and may rewrite after weak evidence."] },
    { "dot": "orange", "title": "Evidence and sources", "items": ["Vector hits are hydrated from indexed PostgreSQL chunks; chat does not fetch Google Drive content.", "Citations refer to prompt chunks. /sources/{chunk_id} loads current indexed chunk text from PostgreSQL."] }
