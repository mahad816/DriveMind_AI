  "cards": [
    { "dot": "cyan", "title": "Separate jobs", "items": ["The UI starts and polls sync, ingest, chunk and build in order, skipping stages with no pending work.", "Jobs run in the FastAPI process; no external queue is involved."] },
    { "dot": "emerald", "title": "Cursor lifecycle", "items": ["Full sync captures a start token before listing and saves it only after listing and reconciliation succeed.", "Incremental sync consumes every Changes API page and saves the new token with successful metadata changes."] },
    { "dot": "orange", "title": "File outcomes", "items": ["Removed, trashed or newly unsupported files are marked skipped; extraction and vector failures mark files failed.", "Build marks a file indexed after vectors are reconciled; empty text or zero chunks remain skipped."] }
