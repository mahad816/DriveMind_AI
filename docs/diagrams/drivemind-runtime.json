  "cards": [
    {
      "dot": "cyan",
      "title": "Knowledge preparation",
      "items": [
        "FastAPI runs in-process sync, ingest, chunk and build jobs after the UI starts them.",
        "Google OAuth authorizes read-only Drive access; it is not an application session gate."
      ]
    },
    {
      "dot": "emerald",
      "title": "Question answering",
      "items": [
        "Answers use the local PostgreSQL/Qdrant index, not a live Drive content fetch.",
        "LangGraph is optional for grounded questions; the default path is linear."
      ]
    },
    {
      "dot": "orange",
      "title": "Storage ownership",
      "items": [
        "PostgreSQL also stores file status, OAuth records and query history.",
        "Qdrant stores embeddings keyed by PostgreSQL chunk UUID, not document text."
      ]
    }
  ]
