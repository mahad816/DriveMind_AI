# Application
APP_NAME=DriveMind AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend demo mode: use a dedicated demo database and Qdrant collection.
# This alone does not certify readiness for public deployment.
DEMO_MODE=false
# Designated UUID in isolated storage; the offline corpus loader can create this User.
DEMO_USER_ID=
# Single instance / one worker: process-wide demo chat limits.
DEMO_CHAT_MAX_QUESTION_CHARS=4000
DEMO_CHAT_MAX_BODY_BYTES=131072
DEMO_CHAT_CONCURRENCY=2
DEMO_CHAT_RATE_LIMIT=20
DEMO_CHAT_RATE_WINDOW_SECONDS=60
# Public deployment: DEBUG=false and APP_ENV=production.

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Frontend (browser — use relative path via Next.js proxy in dev)
NEXT_PUBLIC_API_URL=/api/v1
# Set also in frontend/.env.local; must match backend DEMO_MODE.
NEXT_PUBLIC_DEMO_MODE=false

# Backend URL for Next.js rewrites (server-side proxy target)
BACKEND_URL=http://localhost:8000

# Frontend URL for OAuth callback redirect (Phase 9)
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://drivemind:drivemind@localhost:5432/drivemind

# Local Qdrant (used when QDRANT_URL is empty)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional hosted Qdrant: URL overrides host/port; backend-only key requires HTTPS.
# Use the provider's full endpoint, including its port when specified.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=drivemind_chunks
QDRANT_UPSERT_BATCH_SIZE=100

# Retrieval (Phase 7)
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_K=24
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.35
HYBRID_RRF_K=60
HYBRID_WEIGHT_VECTOR=0.5
HYBRID_WEIGHT_KEYWORD=0.3
HYBRID_WEIGHT_METADATA=0.2
EVIDENCE_MIN_FUSION_SCORE=0.15
FTS_LANGUAGE=english
RAG_MAX_CONTEXT_CHARS=12000

# Tool-orchestrated agent: keep false for normal/default runtime.
# Set true only in the explicitly configured isolated demo backend environment.
TOOL_RAG_AGENT_ENABLED=false

# Legacy LangGraph agent (used only when the tool-agent flag is false)
AGENT_GRAPH_ENABLED=false
AGENT_MAX_REWRITE_ATTEMPTS=2

# Google Drive OAuth (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# LLM / Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# OCR
OCR_ENGINE=tesseract
