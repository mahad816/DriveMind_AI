# Application
APP_NAME=DriveMind AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://drivemind:drivemind@localhost:5432/drivemind

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=drivemind_chunks
QDRANT_UPSERT_BATCH_SIZE=100

# Retrieval (Phase 7)
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CANDIDATE_K=24
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.35
HYBRID_RRF_K=60
HYBRID_WEIGHT_VECTOR=0.5
HYBRID_WEIGHT_KEYWORD=0.3
HYBRID_WEIGHT_METADATA=0.2
EVIDENCE_MIN_FUSION_SCORE=0.15
FTS_LANGUAGE=english
RAG_MAX_CONTEXT_CHARS=12000

# LangGraph agent (Phase 8)
AGENT_GRAPH_ENABLED=false
AGENT_MAX_REWRITE_ATTEMPTS=2

# Google Drive OAuth (read-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# LLM / Embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# OCR
OCR_ENGINE=tesseract
