{
  "name": "drivemind-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "DriveMind AI \u2014 Next.js frontend",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:stub": "STUB_PORT=8100 STUB_FRONTEND=http://127.0.0.1:3100 node e2e/stub/server.mjs",
    "e2e:app": "BACKEND_URL=http://127.0.0.1:8100 next dev --turbopack -p 3100 -H 127.0.0.1",
    "e2e:journeys": "node e2e/journeys/journeys.mjs",
    "e2e:responsive": "node e2e/journeys/responsive.mjs",
    "e2e:app:demo": "NEXT_PUBLIC_DEMO_MODE=true BACKEND_URL=http://127.0.0.1:8100 next dev --turbopack -p 3100 -H 127.0.0.1",
    "e2e:demo": "node e2e/journeys/demo.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
