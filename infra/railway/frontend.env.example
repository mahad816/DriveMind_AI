# Runtime settings plus an explicit public build flag. Backend origin includes its port.
PORT=3000
BACKEND_URL=
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=210
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
# NEXT_PUBLIC_API_URL=/api/v1 and NEXT_PUBLIC_DEMO_MODE=false are fixed by
# the normal image at build time, not mutable runtime identity/configuration.
# Build-time opt-in (Docker ARG); changing it requires rebuilding the frontend.
NEXT_PUBLIC_CHAT_STREAMING_ENABLED=false
