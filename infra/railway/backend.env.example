# SANITIZED NORMAL-BETA TEMPLATE. Blank secrets must be supplied out of band.
PORT=8000
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DEMO_MODE=false
FRONTEND_URL=
GOOGLE_APPLICATION_SESSIONS_ENABLED=true
# Comma-separated verified Google e-mails allowed to sign in; empty means nobody can.
GOOGLE_SIGN_IN_ALLOWED_EMAILS=owner@example.invalid
GOOGLE_SESSION_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
# Login start limit (M0-SEC ticket 07, KI-032): global and process-local. Resets on restart; each
# worker has its own window. A flood above it can delay the Owner's own sign-in but reads or
# changes nothing. Per-IP or edge limiting is an M9 decision.
GOOGLE_LOGIN_START_RATE_LIMIT=30
GOOGLE_LOGIN_START_RATE_WINDOW_SECONDS=60

# Paid-question quota per Owner (M0-SEC tickets 05 and 06). PROVISIONAL, not measured: recalibrate
# from M1 data before any redeploy (M9 gate). One count is one admitted question, not a dollar
# amount and not a count of provider calls. Rolling windows; stored in PostgreSQL (migration
# 20261121_1200). Over a limit: HTTP 429 with Retry-After before any provider call. Unusable
# ledger: HTTP 503 (fails closed).
PAID_QUESTION_HOUR_LIMIT=20
PAID_QUESTION_DAY_LIMIT=50
PAID_QUESTION_CONCURRENT_LIMIT=1
# Lease rule: PAID_QUESTION_LEASE_SECONDS must be at least the longest execution bound below plus
# 60 seconds, or the application refuses to start. CONVERSATION_GENERATION_TIMEOUT must be below
# CONVERSATION_EXECUTION_SECONDS.
PAID_QUESTION_LEASE_SECONDS=300
PAID_QUESTION_RETENTION_HOURS=25
CONVERSATION_EXECUTION_SECONDS=180
CONVERSATION_GENERATION_TIMEOUT=120
CHAT_EXECUTION_SECONDS=180
GOOGLE_CREDENTIAL_ENCRYPTION_KEYRING=
GOOGLE_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=
# Required dialect: postgresql+asyncpg://; use Railway private PG* references.
# Percent-encode generated credentials; no DATABASE_PUBLIC_URL or real values here.
DATABASE_URL=
QDRANT_URL=
QDRANT_COLLECTION=drivemind_beta_chunks
# Empty for isolated private HTTP; existing client requires HTTPS for any key.
QDRANT_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5.4-nano
QDRANT_UPSERT_BATCH_SIZE=100
HYBRID_RETRIEVAL_ENABLED=true
AGENT_GRAPH_ENABLED=false
TOOL_RAG_AGENT_ENABLED=false
# Streaming stays off until a separate backend-first rollout is approved.
CHAT_STREAMING_ENABLED=false
INDEXING_ENABLED=false
INDEXING_ACTIVATION_TARGET=
INDEXING_DATABASE_SCHEMA=public
INDEXING_POLL_SECONDS=1
INDEXING_CLASSIFIER_SECONDS=5
INDEXING_DEPENDENCY_SECONDS=5
INDEXING_DEPENDENCY_TIMEOUT=5
INDEXING_STARTUP_TIMEOUT=30
INDEXING_DRAIN_SECONDS=20
INDEXING_CLEANUP_SECONDS=5
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=210
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
