# SANITIZED NORMAL-BETA TEMPLATE. Blank secrets must be supplied out of band.
PORT=8000
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1
DEMO_MODE=false
FRONTEND_URL=
GOOGLE_APPLICATION_SESSIONS_ENABLED=true
GOOGLE_SESSION_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
GOOGLE_CREDENTIAL_ENCRYPTION_KEYRING=
GOOGLE_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=
DATABASE_URL=
QDRANT_URL=
QDRANT_COLLECTION=drivemind_beta_chunks
# Empty for isolated private HTTP; existing client requires HTTPS for any key.
QDRANT_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
QDRANT_UPSERT_BATCH_SIZE=100
HYBRID_RETRIEVAL_ENABLED=true
AGENT_GRAPH_ENABLED=false
TOOL_RAG_AGENT_ENABLED=false
INDEXING_ENABLED=false
INDEXING_ACTIVATION_TARGET=
INDEXING_DATABASE_SCHEMA=public
INDEXING_POLL_SECONDS=1
INDEXING_CLASSIFIER_SECONDS=5
INDEXING_DEPENDENCY_SECONDS=5
INDEXING_DEPENDENCY_TIMEOUT=5
INDEXING_STARTUP_TIMEOUT=30
INDEXING_DRAIN_SECONDS=20
INDEXING_CLEANUP_SECONDS=5
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=210
