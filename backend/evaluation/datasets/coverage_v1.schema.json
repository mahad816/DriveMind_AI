{
  "$defs": {
    "CoverageCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^coverage-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "development",
            "held_out"
          ],
          "title": "Split",
          "type": "string"
        },
        "scenario_group": {
          "minLength": 1,
          "title": "Scenario Group",
          "type": "string"
        },
        "context_fixture": {
          "minLength": 1,
          "title": "Context Fixture",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/CoverageInput"
        },
        "expected_verdict": {
          "$ref": "#/$defs/CoverageVerdict"
        },
        "family": {
          "enum": [
            "faithful",
            "target_change",
            "scope_change",
            "dependency_loss",
            "missing_request",
            "reference_change",
            "unsupported_meaning_loss",
            "uncertain_reference",
            "adversarial"
          ],
          "title": "Family",
          "type": "string"
        },
        "notes": {
          "minLength": 1,
          "title": "Notes",
          "type": "string"
        },
        "source_routing_case": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Routing Case"
        }
      },
      "required": [
        "id",
        "split",
        "scenario_group",
        "context_fixture",
        "input",
        "expected_verdict",
        "family",
        "notes"
      ],
      "title": "CoverageCase",
      "type": "object"
    },
    "CoverageContext": {
      "additionalProperties": false,
      "properties": {
        "snapshot_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Identity",
          "type": "string"
        },
        "prior_file_count": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Prior File Count",
          "type": "integer"
        },
        "prior_topic_count": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Prior Topic Count",
          "type": "integer"
        },
        "user_history_positions": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "title": "User History Positions",
          "type": "array"
        },
        "assistant_history_positions": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 6,
          "title": "Assistant History Positions",
          "type": "array"
        }
      },
      "required": [
        "snapshot_identity"
      ],
      "title": "CoverageContext",
      "type": "object"
    },
    "CoverageInput": {
      "additionalProperties": false,
      "properties": {
        "serialization_version": {
          "const": "coverage-input-1.0",
          "default": "coverage-input-1.0",
          "title": "Serialization Version",
          "type": "string"
        },
        "original_question": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Original Question",
          "type": "string"
        },
        "interpretation": {
          "$ref": "#/$defs/InterpretationSummary"
        },
        "context": {
          "$ref": "#/$defs/CoverageContext"
        },
        "routing_contract_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Routing Contract Identity",
          "type": "string"
        },
        "interpretation_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Interpretation Identity",
          "type": "string"
        },
        "context_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Identity",
          "type": "string"
        },
        "contract_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contract Identity",
          "type": "string"
        },
        "input_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Identity",
          "type": "string"
        }
      },
      "required": [
        "original_question",
        "interpretation",
        "context",
        "routing_contract_identity",
        "interpretation_identity",
        "context_identity",
        "contract_identity",
        "input_identity"
      ],
      "title": "CoverageInput",
      "type": "object"
    },
    "CoverageVerdict": {
      "enum": [
        "PRESERVED",
        "MISMATCH",
        "UNCERTAIN"
      ],
      "title": "CoverageVerdict",
      "type": "string"
    },
    "FileContextKind": {
      "enum": [
        "IT",
        "THAT",
        "THIS_FILE",
        "PREVIOUS_DOCUMENT"
      ],
      "title": "FileContextKind",
      "type": "string"
    },
    "FileContextReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "PRIOR_CONVERSATION_FILE_REFERENCE",
          "default": "PRIOR_CONVERSATION_FILE_REFERENCE",
          "title": "Kind",
          "type": "string"
        },
        "reference_kind": {
          "$ref": "#/$defs/FileContextKind"
        }
      },
      "required": [
        "reference_kind"
      ],
      "title": "FileContextReference",
      "type": "object"
    },
    "HistoryReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "HISTORY_REFERENCE",
          "default": "HISTORY_REFERENCE",
          "title": "Kind",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "relative_position": {
          "maximum": 6,
          "minimum": 1,
          "title": "Relative Position",
          "type": "integer"
        }
      },
      "required": [
        "role",
        "relative_position"
      ],
      "title": "HistoryReference",
      "type": "object"
    },
    "InputSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "exclusiveMaximum": 8000,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "maximum": 8000,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "InputSpan",
      "type": "object"
    },
    "InterpretationSummary": {
      "additionalProperties": false,
      "properties": {
        "proposed_cardinality": {
          "enum": [
            "ONE",
            "TWO",
            "THREE",
            "OVER_LIMIT"
          ],
          "title": "Proposed Cardinality",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "PROPOSED_OPERATIONS",
            "NON_EXECUTABLE"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "requests": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RequestSummary"
          },
          "maxItems": 3,
          "title": "Requests",
          "type": "array"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnsupportedReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "special_selections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpecialSelection"
          },
          "maxItems": 3,
          "title": "Special Selections",
          "type": "array"
        }
      },
      "required": [
        "proposed_cardinality",
        "disposition"
      ],
      "title": "InterpretationSummary",
      "type": "object"
    },
    "LiteralReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "LITERAL_FILE",
          "default": "LITERAL_FILE",
          "title": "Kind",
          "type": "string"
        },
        "current_input_span": {
          "$ref": "#/$defs/InputSpan"
        },
        "current_input_filename": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Current Input Filename",
          "type": "string"
        }
      },
      "required": [
        "current_input_span",
        "current_input_filename"
      ],
      "title": "LiteralReference",
      "type": "object"
    },
    "ReferenceSelector": {
      "enum": [
        "LATEST",
        "OLDEST"
      ],
      "title": "ReferenceSelector",
      "type": "string"
    },
    "RequestSummary": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "maximum": 3,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "capability": {
          "enum": [
            "FILE_INVENTORY",
            "FILE_TARGET",
            "COLLECTION_SUMMARY",
            "GROUNDED_RAG",
            "CONVERSATION_HISTORY",
            "CHITCHAT"
          ],
          "title": "Capability",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "reference": {
          "discriminator": {
            "mapping": {
              "CURRENT_BUNDLE_RESULT_REFERENCE": "#/$defs/RuntimeReference",
              "DEFAULT_COLLECTION": "#/$defs/SimpleReference",
              "HISTORY_REFERENCE": "#/$defs/HistoryReference",
              "INDEPENDENT_METADATA_SELECTION": "#/$defs/SelectorReference",
              "LITERAL_FILE": "#/$defs/LiteralReference",
              "ORIGINAL_QUERY": "#/$defs/SimpleReference",
              "PRIOR_CONVERSATION_FILE_REFERENCE": "#/$defs/FileContextReference",
              "PRIOR_CONVERSATION_TOPIC_REFERENCE": "#/$defs/TopicContextReference",
              "SOCIAL_INPUT": "#/$defs/SimpleReference",
              "UNSPECIFIED_FILE": "#/$defs/SimpleReference"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LiteralReference"
            },
            {
              "$ref": "#/$defs/SelectorReference"
            },
            {
              "$ref": "#/$defs/FileContextReference"
            },
            {
              "$ref": "#/$defs/TopicContextReference"
            },
            {
              "$ref": "#/$defs/RuntimeReference"
            },
            {
              "$ref": "#/$defs/HistoryReference"
            },
            {
              "$ref": "#/$defs/SimpleReference"
            }
          ],
          "title": "Reference"
        },
        "scope": {
          "enum": [
            "ALL_VISIBLE_INDEXED_FILES",
            "ONE_REFERENCED_FILE",
            "INDEXED_DOCUMENT_CONTENTS",
            "BOUNDED_CONVERSATION_HISTORY",
            "SOCIAL_ONLY"
          ],
          "title": "Scope",
          "type": "string"
        },
        "filter": {
          "const": "NONE",
          "default": "NONE",
          "title": "Filter",
          "type": "string"
        },
        "ordering": {
          "anyOf": [
            {
              "enum": [
                "NAME_ASC",
                "NAME_DESC",
                "MODIFIED_AT_ASC",
                "MODIFIED_AT_DESC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordering"
        },
        "source_span": {
          "$ref": "#/$defs/InputSpan"
        },
        "source_text_provenance_only": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Source Text Provenance Only",
          "type": "string"
        },
        "query_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query_text_provenance_only": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Text Provenance Only"
        }
      },
      "required": [
        "position",
        "capability",
        "operation",
        "reference",
        "scope",
        "source_span",
        "source_text_provenance_only"
      ],
      "title": "RequestSummary",
      "type": "object"
    },
    "RuntimeReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "CURRENT_BUNDLE_RESULT_REFERENCE",
          "default": "CURRENT_BUNDLE_RESULT_REFERENCE",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RuntimeReference",
      "type": "object"
    },
    "SelectorReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "INDEPENDENT_METADATA_SELECTION",
          "default": "INDEPENDENT_METADATA_SELECTION",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ReferenceSelector"
        }
      },
      "required": [
        "selector"
      ],
      "title": "SelectorReference",
      "type": "object"
    },
    "SimpleReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "DEFAULT_COLLECTION",
            "ORIGINAL_QUERY",
            "SOCIAL_INPUT",
            "UNSPECIFIED_FILE"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SimpleReference",
      "type": "object"
    },
    "SpecialSelection": {
      "additionalProperties": false,
      "properties": {
        "position": {
          "maximum": 3,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "special": {
          "enum": [
            "UNSUPPORTED_OPERATION",
            "SEMANTICALLY_AMBIGUOUS"
          ],
          "title": "Special",
          "type": "string"
        }
      },
      "required": [
        "position",
        "special"
      ],
      "title": "SpecialSelection",
      "type": "object"
    },
    "TopicContextReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "PRIOR_CONVERSATION_TOPIC_REFERENCE",
          "default": "PRIOR_CONVERSATION_TOPIC_REFERENCE",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TopicContextReference",
      "type": "object"
    },
    "UnsupportedReason": {
      "enum": [
        "OPERATION",
        "SCOPE",
        "DEPENDENCY",
        "RESULT_DEPENDENCY_UNSUPPORTED",
        "REQUEST_LIMIT"
      ],
      "title": "UnsupportedReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "const": "coverage_v1",
      "title": "Dataset Id",
      "type": "string"
    },
    "schema_version": {
      "const": "coverage-pairs-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic_only": {
      "const": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "contract_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Identity",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CoverageCase"
      },
      "maxItems": 80,
      "minItems": 80,
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "schema_version",
    "synthetic_only",
    "contract_identity",
    "cases"
  ],
  "title": "CoverageDataset",
  "type": "object"
}
